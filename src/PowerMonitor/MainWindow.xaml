<Window x:Class="PowerMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="Power Monitor" Height="660" Width="840"
        MinHeight="520" MinWidth="620"
        Background="#1E1F22" Foreground="#E8EAED"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI" UseLayoutRounding="True">

    <Window.Resources>
        <!-- Card container -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#26282C" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="BorderBrush" Value="#33363B" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA0A6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <!-- Slim bar used for component + per-process fills -->
        <Style x:Key="Bar" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="#33363B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="4" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Battery card ============ -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="BATTERY POWER" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding BatteryHeadline}" Foreground="{Binding HeadlineBrush}"
                               FontSize="46" FontWeight="Bold" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding BatteryDirection}" Foreground="#C0C4C9" FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="32,0,0,0">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Charge" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding BatteryPercentText}" FontSize="16" FontWeight="SemiBold" />
                    </Grid>
                    <ProgressBar Style="{StaticResource Bar}" Height="10" Minimum="0" Maximum="100"
                                 Value="{Binding BatteryPercent}" Foreground="{Binding HeadlineBrush}" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TIME LEFT" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding TimeRemainingText}" FontSize="13" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="VOLTAGE / CURRENT" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding VoltageCurrentText}" FontSize="13" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="CAPACITY" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding CapacityText}" FontSize="13" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Trend chart ============ -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="POWER DRAW — LAST ~2 MIN" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                <Canvas x:Name="ChartCanvas" Height="90" ClipToBounds="True" Background="Transparent" />
            </StackPanel>
        </Border>

        <!-- ============ Component breakdown ============ -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="WHERE THE POWER GOES" Style="{StaticResource Caption}" Margin="0,0,0,10" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CPU" VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="1" Style="{StaticResource Bar}" Value="{Binding CpuBar}"
                                 Foreground="#4C9AFF" VerticalAlignment="Center" Margin="8,0,4,0" />
                    <TextBlock Grid.Column="2" Text="{Binding CpuWattsText}" TextAlignment="Right"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="GPU" VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="1" Style="{StaticResource Bar}" Value="{Binding GpuBar}"
                                 Foreground="#2ECC71" VerticalAlignment="Center" Margin="8,0,4,0" />
                    <TextBlock Grid.Column="2" Text="{Binding GpuWattsText}" TextAlignment="Right"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>

                <Grid Opacity="{Binding OtherRowOpacity}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding OtherLabel}" VerticalAlignment="Center"
                               Foreground="#C0C4C9" TextTrimming="CharacterEllipsis" />
                    <Grid Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center">
                        <ProgressBar Style="{StaticResource Bar}" Value="{Binding OtherBar}" Foreground="#9AA0A6" />
                        <TextBlock Text="{Binding OtherNote}" FontSize="10" FontStyle="Italic"
                                   Foreground="#9AA0A6" VerticalAlignment="Center"
                                   HorizontalAlignment="Left" Margin="2,0,0,0" />
                    </Grid>
                    <TextBlock Grid.Column="2" Text="{Binding OtherWattsText}" TextAlignment="Right"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>

                <Border Height="1" Background="#33363B" Margin="0,10" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding TotalLabel}" VerticalAlignment="Center"
                               FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding TotalWattsText}" TextAlignment="Right"
                               FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ============ Per-process table ============ -->
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="TOP PROGRAMS BY ESTIMATED POWER" Style="{StaticResource Caption}" Margin="0,0,0,8" />

                <Grid Grid.Row="1" Margin="0,0,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Process" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="1" Text="CPU" Style="{StaticResource Caption}" TextAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="GPU" Style="{StaticResource Caption}" TextAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="WATTS" Style="{StaticResource Caption}" TextAlignment="Right" />
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Processes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="28">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>

                                    <!-- bar fill behind the process name -->
                                    <ProgressBar Grid.Column="0" Style="{StaticResource Bar}" Height="22"
                                                 Value="{Binding BarFraction}" Foreground="#2F3B57"
                                                 Background="Transparent" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                               Margin="8,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding CpuText}" TextAlignment="Right"
                                               Foreground="#C0C4C9" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding GpuText}" TextAlignment="Right"
                                               Foreground="#C0C4C9" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding WattsText}" TextAlignment="Right"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ============ Status bar ============ -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="#9AA0A6"
                       FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" Content="Restart as administrator" x:Name="ElevateButton"
                    Visibility="{Binding ElevateVisibility}" Click="ElevateButton_Click"
                    Padding="12,6" Cursor="Hand" />
        </Grid>

        <!-- ============ Tray icon ============ -->
        <tb:TaskbarIcon x:Name="Tray" ToolTipText="Power Monitor"
                        TrayMouseDoubleClick="Tray_DoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show" Click="TrayShow_Click" />
                    <MenuItem Header="Exit" Click="TrayExit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
